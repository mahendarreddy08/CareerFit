entrypoint = "frontend/apps/web/app/page.tsx"
modules = ["nodejs-20"]
run = "npm --prefix frontend/apps/web run dev -- -p 3000"

[nix]
channel = "stable-24_05"

[deployment]
run = ["npm", "--prefix", "frontend/apps/web", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80
